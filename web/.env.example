# ローカルで動かすときの設定の見本。値は入れずにコピーして .env.local を作る（.env.local はコミットしない）
# Vertex AI（Gemini）と Firestore を使う Google Cloud のプロジェクト。認証は gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 外の動画を探す YouTube Data API のキー（本番は Secret Manager から渡す）
YOUTUBE_API_KEY=
# 合言葉（空なら合言葉なしで開ける）
SITE_PASSWORD=
# 任意：モデルと AI の1日の上限
# GEMINI_VISION_MODEL=gemini-3.5-flash
# GEMINI_CLASSIFY_MODEL=gemini-3.1-flash-lite
# GEMINI_DAILY_LIMIT=1500
